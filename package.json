{
	"name": "phil.red",
	"version": "1.0.0",
	"description": "flying-sheep’s blog",
	"private": true,
	"main": "dist/bundle.js",
	"type": "module",
	"repository": "https://github.com/flying-sheep/phil.red.git",
	"author": "Philipp A. <flying-sheep@web.de>",
	"license": "GPL-3.0",
	"scripts": {
		"start": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "$npm_execpath run lint:check && $npm_execpath run lint:deps",
		"lint:ci": "biome ci && $npm_execpath run lint:deps",
		"lint:check": "biome check --write .",
		"lint:deps": "depcheck --ignores=unfonts.css,vega,vega-lite,@fontsource/iosevka,@fontsource/iosevka-aile,@tsconfig/strictest,@total-typescript/ts-reset,@arborium/ini,@arborium/python,@arborium/toml,@arborium/typescript,@arborium/xml,@arborium/zsh",
		"deploy": "$npm_execpath run build && rsync --recursive --delete --archive --compress --progress dist/ root@phil.red:/srv/http/phil.red",
		"prepare": "husky"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@arborium/arborium": "^2.18.1",
		"@arborium/ini": "^2.18.1",
		"@arborium/python": "^2.18.1",
		"@arborium/toml": "^2.18.1",
		"@arborium/typescript": "^2.18.1",
		"@arborium/xml": "^2.18.1",
		"@arborium/zsh": "^2.18.1",
		"@dr.pogodin/react-helmet": "^3.2.3",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/iosevka": "^5.3.0",
		"@fontsource/iosevka-aile": "^5.3.0",
		"@mui/icons-material": "^9.3.1",
		"@mui/material": "^9.3.1",
		"@mui/system": "^9.0.0",
		"merge-sx": "^4.0.0",
		"notistack": "^3.0.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.3",
		"react-is": "^19.2.8",
		"react-portal-target": "^1.0.2",
		"react-router": "^8.3.0",
		"react-slide-routes": "^3.1.0",
		"react-vega": "^8.0.0",
		"temml": "^0.13.4",
		"typed-jsx": "^0.1.1",
		"vega": "^6.4.0",
		"vega-embed": "^7.1.0",
		"vega-lite": "^6.4.3",
		"vega-util": "^2.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@oxc-project/types": "^0.147",
		"@total-typescript/ts-reset": "^0.6.1",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^26.3.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@types/react-is": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.5",
		"@yarnpkg/fslib": "^3.1.5",
		"@yarnpkg/libzip": "^3.2.2",
		"depcheck": "^1.4.7",
		"globby": "^16.2.4",
		"husky": ">=9.1.7",
		"lint-staged": ">=17.3.0",
		"magic-string": "^1.2.0",
		"markdown-it": "^15.0.0",
		"oxc-walker": "^1.1.1",
		"pyodide": "^314.0.6",
		"react-base16-styling": "^0.10.0",
		"react-json-tree": "^0.20.0",
		"typescript": "^6.0.3",
		"unplugin-fonts": "^2.0.0",
		"vega-typings": "^2.3.0",
		"vite": "^8.2.2"
	},
	"packageManager": "yarn@4.18.0",
	"//": "https://github.com/yarnpkg/berry/issues/3366",
	"resolutions": {
		"node-gyp": "npm:optional-pkg@1"
	},
	"lint-staged": {
		"!(rawPosts)": "biome check --no-errors-on-unmatched --files-ignore-unknown=true --write"
	}
}
